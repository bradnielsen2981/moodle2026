{{!
    @template theme_boost_union/secondary_icons

    Template to render secondary navigation as icon links.
}}
<div class="secondary-navigation-icons d-flex flex-wrap gap-2 py-3 justify-content-center">
    {{#custom_nodes}}
        {{^haschildren}}
            <a href="{{{url}}}" class="btn btn-icon icon-size-3 {{#isactive}}active{{/isactive}} secondary-icon-link secondary-icon-key-{{key}}" title="{{{text}}}" data-bs-toggle="tooltip" data-bs-placement="bottom">
                {{{iconhtml}}}
                <span class="visually-hidden">{{{text}}}</span>
            </a>
        {{/haschildren}}
        {{#haschildren}}
            <div class="dropdown">
                <button class="btn btn-icon icon-size-3 {{#isactive}}active{{/isactive}} secondary-icon-link secondary-icon-key-{{key}}" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{{text}}}" data-bs-toggle="tooltip" data-bs-placement="bottom">
                    {{{iconhtml}}}
                    <span class="visually-hidden">{{{text}}}</span>
                </button>
                <ul class="dropdown-menu shadow">
                    {{#children}}
                        <li><a class="dropdown-item {{#isactive}}active{{/isactive}}" href="{{{url}}}">{{{text}}}</a></li>
                    {{/children}}
                </ul>
            </div>
        {{/haschildren}}
    {{/custom_nodes}}
</div>
