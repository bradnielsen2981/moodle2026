{{!
    @template format_multipageformat/local/content

    Extends core_courseformat/local/content, replacing only the JS module it loads so the
    course editor uses format_multipageformat/local/content instead of core's own module.
    Everything else (markup, sections, addsection, etc.) is inherited unchanged.
}}
{{< core_courseformat/local/content}}
    {{$ core_courseformat/local/content-js}}
        {{#js}}
require(['format_multipageformat/local/content'], function(component) {
    component.init(
        '#page', {}, {{sectionreturn}}, {{#pagesectionid}}{{.}}{{/pagesectionid}}{{^pagesectionid}}null{{/pagesectionid}}
    );
});
        {{/js}}
    {{/ core_courseformat/local/content-js}}
{{/ core_courseformat/local/content}}
