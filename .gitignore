# Local site configuration - contains database credentials, must never be committed.
/config.php
/public/config.php

# npm/Grunt JS toolchain - installed locally, not part of the Moodle source.
/node_modules/
npm-debug.log
yarn-error.log

# Generated by `grunt ignorefiles` / copied from *.dist - regenerate locally instead of tracking.
/.eslintignore
/.stylelintignore
/phpcs.xml

# Composer dependencies - installed locally, not part of the Moodle source.
/vendor/

# Playwright MCP tool scratch output (screenshots, console logs, page snapshots).
/.playwright-mcp/

# OS/editor cruft.
.DS_Store
Thumbs.db
